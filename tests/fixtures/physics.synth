# fixture golden: um synth por primitivo de modelagem fisica - se
# qualquer fisica mudar (de proposito ou nao), o fingerprint acusa.
synth p_bow {
  poly 2 steal oldest
  kill after 4s
  voice {
    let v = env { 0 -> 0.85 in 100ms curve exp sustain 0.85 release -> 0 in 120ms curve exp }
    out bow(freq: hz(note), pressure: 0.55, velocity: v, position: 0.12, damp: 0.3)
  }
}

synth p_string {
  poly 4 steal oldest
  kill after 4s
  voice {
    out string(freq: hz(note), decay: 3s, bright: 0.65, position: 0.28,
               exciter: pick, hard: 0.6, stiff: 0.2, pol: 0.5, tension: 0.1)
  }
}

synth p_flute {
  poly 2 steal oldest
  kill after 3s
  voice {
    let p = env { 0 -> 1 in 60ms curve exp sustain 1 release -> 0 in 100ms curve exp }
    out flute(freq: hz(note), pressure: p, breath: 0.03)
  }
}

synth p_reed {
  poly 2 steal oldest
  kill after 3s
  voice {
    let p = env { 0 -> 0.85 in 80ms curve exp sustain 0.85 release -> 0 in 100ms curve exp }
    out reed(freq: hz(note), pressure: p, stiffness: 0.5)
  }
}

synth p_brass {
  poly 2 steal oldest
  kill after 3s
  voice {
    let p = env { 0 -> 1 in 45ms curve exp sustain 1 release -> 0 in 120ms curve exp }
    out brass(freq: hz(note), pressure: p * 0.9, lip: 1.0, bell: 1.4khz, rasp: 0.5)
  }
}

synth p_voz {
  poly 2 steal oldest
  voice {
    let a = adsr(attack: 90ms, decay: 60ms, sustain: 0.9, release: 200ms)
    out voz(freq: hz(note), vowel: 0, tipo: tenor, ens: 4, vib: 0.15) * a
  }
}

synth p_sino {
  poly 2 steal oldest
  kill after 6s
  voice {
    let m = [(0.5, 5s, 0.5), (1.0, 4s, 1.0), (1.183, 3s, 0.8), (2.0, 2s, 0.7)]
    out modal2(freq: hz(note), modes: m, doublet: 0.15%, strike: 0.3, hard: 0.7)
  }
}

synth corpo_teste {
  poly 1
  kill after 1s
  voice {
    let m = [(1.0, 0.1s, 1.0), (1.7, 0.07s, 0.7), (2.6, 0.05s, 0.5)]
    out modal2(freq: 300hz, modes: m, doublet: 0.1%, strike: 0.4, hard: 0.8)
  }
}

synth p_nwave {
  poly 2 steal oldest
  kill after 2s
  voice {
    out nwave(dur: 3ms, sharp: 0.85, reflect: 5ms, air: 12khz)
  }
  bus {
    convolve(ir: corpo_teste, dur: 150ms, mix: 60%)
  }
}
