# fixture golden: exercita a DSL de score inteira (sections/arrange,
# swing, humanize, automate, tempo map, acordes, repeticao) com synths
# simples - se o agendamento mudar, o fingerprint muda.
synth lead {
  poly 6 steal oldest
  gain -8db

  param cutoff: hz = 2000 range 200..8000 smooth 15ms curve log

  voice {
    let osc = saw(freq: note, unison: 3, spread: 8ct, gain: 0.5)
    let amp = adsr(attack: 8ms, decay: 120ms, sustain: 0.6, release: 150ms)
    out lowpass(osc, cutoff: cutoff, q: 0.4) * amp * velocity
  }
}

synth grave {
  poly 3 steal oldest
  gain -6db

  voice {
    let osc = sine(freq: note, gain: 0.7) + triangle(freq: note + 12st, gain: 0.15)
    let amp = adsr(attack: 5ms, decay: 200ms, sustain: 0.7, release: 120ms)
    out osc * amp * velocity
  }
}

master {
  bus_gain -1db
  limiter(ceiling: -1db, lookahead: 5ms, release: 60ms)
}
