# lutier presets - cordas por modelagem fisica (overhaul SOTA)
# Motor: string() = corda dedilhada EKS/waveguide com 2 polarizacoes,
# dispersao, tension modulation, colisao de traste e tap de captador;
# bow() v2 = waveguide de arco com friccao termica (Woodhouse 2003),
# canal torsional e reflexao com perda dependente de frequencia.
# Corpos: modal2 com MODOS MEDIDOS da literatura (Bissinger, Gough,
# Woodhouse, Rossing, Politzer) convolvidos por IR gerada - zero samples.

# ---------------------------------------------------------------- corpos

# Corpo de violino com MODOS MEDIDOS da literatura (Woodhouse/Bissinger,
# violino "Titian"): A0 275hz, CBR 405, B1- 460, B1+ 550, cluster de tampo
# 700-2100 e o "bridge hill" largo em 2.3-2.8khz (o brilho de verniz).
# Razoes relativas a 275hz; decay = 2.2*Q/f. Usado SOMENTE como IR do convolve.
synth corpo_violino {
  poly 1
  kill after 1s

  voice {
    let modos = [
      (1.0,   0.085s, 1.0),
      (1.473, 0.06s,  0.35),
      (1.673, 0.065s, 0.85),
      (2.0,   0.062s, 0.9),
      (2.545, 0.045s, 0.5),
      (3.055, 0.04s,  0.45),
      (3.636, 0.035s, 0.4),
      (4.364, 0.03s,  0.35),
      (5.273, 0.025s, 0.3),
      (6.364, 0.022s, 0.3),
      (7.636, 0.018s, 0.25),
      (8.364, 0.009s, 0.28),
      (9.273, 0.008s, 0.3),
      (10.18, 0.008s, 0.26)
    ]
    out modal2(freq: 275hz, modes: modos, doublet: 0.15%, strike: 0.35, hard: 0.85)
  }
}

# Corpo de violino - variante direita: mesmos modos com desvios pequenos
# (nenhum corpo e simetrico). convolve(ir:, ir2:) usa um por canal =
# decorrelacao L/R real, sem truques de fase.
