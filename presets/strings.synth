# --------------------------------------------------------------- arco

# Violino solo v2: friccao termica + torsional do bow() v2 fazem o grosso;
# gesto = arcada com overshoot, vibrato atrasado com drift, pressao que
# cede. Toque g3..e6.
synth violino {
  poly 4 steal oldest
  gain -1db
  # vibrato opcional: 0 = senza vibrato (arco reto), 1 = normal,
  # ate 2 = largo. No score: set vibrato 0 / automate vibrato ...
  param vibrato: scalar = 1 range 0..2 smooth 60ms
  kill after 8s

  voice {
    let vib_depth = env { 0 -> 0 in 250ms curve lin -> 1 in 500ms curve log }
    let vib_rate_drift = lfo(shape: sample_hold, rate: 1.3hz, amount: 0.4)
    let vib = lfo(shape: sine, rate: 5.9hz + vib_rate_drift) * vib_depth * vibrato * 0.15st
    let arco = env { 0 -> 1.0 in 70ms curve exp -> 0.82 in 160ms curve exp
                     sustain 0.82 release -> 0 in 160ms curve exp }
    let drift = lfo(shape: sine, rate: 0.35hz, amount: 0.04)
    # rampa de Guettler: forca sobe JUNTO com a velocidade do arco
    let pressao = (0.42 + velocity * 0.3) * env { 0.35 -> 1 in 160ms curve exp sustain 1 release -> 0.7 in 120ms curve lin }
    let corda = bow(freq: hz(note + vib), pressure: pressao, velocity: arco + drift,
                    position: 0.12, damp: 0.25, noise: 0.09, stroke: 2s)
    out corda * 0.8
  }

  bus {
    convolve(ir: corpo_violino, ir2: corpo_violino_r, dur: 120ms, mix: 45%)
    reverb(size: 0.7, decay: 1.6s, damp: 6khz, mix: 12%)
  }
}

# Viola: corda mais pesada e escura, vibrato mais lento que violino,
# corpo nasal proprio. Toque c3..c5.
synth viola {
  poly 4 steal oldest
  gain -2db
  # vibrato opcional: 0 = senza vibrato (arco reto), 1 = normal,
  # ate 2 = largo. No score: set vibrato 0 / automate vibrato ...
  param vibrato: scalar = 1 range 0..2 smooth 60ms
  kill after 8s

  voice {
    let vib_depth = env { 0 -> 0 in 300ms curve lin -> 1 in 550ms curve log }
    let vib_rate_drift = lfo(shape: sample_hold, rate: 1.1hz, amount: 0.35)
    let vib = lfo(shape: sine, rate: 5.6hz + vib_rate_drift) * vib_depth * vibrato * 0.16st
    let arco = env { 0 -> 0.95 in 90ms curve exp -> 0.8 in 180ms curve exp
                     sustain 0.8 release -> 0 in 180ms curve exp }
    let drift = lfo(shape: sine, rate: 0.3hz, amount: 0.04)
    let pressao = (0.47 + velocity * 0.28) * env { 0.35 -> 1 in 180ms curve exp sustain 1 release -> 0.72 in 130ms curve lin }
    let corda = bow(freq: hz(note + vib), pressure: pressao, velocity: arco + drift,
                    position: 0.11, damp: 0.32, noise: 0.09, stroke: 2.3s)
    out corda * 0.8
  }

  bus {
    convolve(ir: corpo_viola, dur: 140ms, mix: 48%)
    reverb(size: 0.72, decay: 1.7s, damp: 5khz, mix: 13%)
  }
}

# Cello v2: arco pesado, vibrato 5hz largo, corpo com os dois hills.
# Toque c2..a4.
synth cello {
  poly 3 steal oldest
  gain -6db
  # vibrato opcional: 0 = senza vibrato (arco reto), 1 = normal,
  # ate 2 = largo. No score: set vibrato 0 / automate vibrato ...
  param vibrato: scalar = 1 range 0..2 smooth 60ms
  kill after 9s

  voice {
    let vib_depth = env { 0 -> 0 in 350ms curve lin -> 1 in 650ms curve log }
    let vib_rate_drift = lfo(shape: sample_hold, rate: 0.9hz, amount: 0.3)
    let vib = lfo(shape: sine, rate: 5.0hz + vib_rate_drift) * vib_depth * vibrato * 0.2st
    let arco = env { 0 -> 0.85 in 130ms curve exp sustain 0.85 release -> 0 in 220ms curve exp }
    let drift = lfo(shape: sine, rate: 0.28hz, amount: 0.05)
    let pressao = (0.52 + velocity * 0.24) * env { 0.4 -> 1 in 200ms curve exp sustain 1 release -> 0.75 in 150ms curve lin }
    let corda = bow(freq: hz(note + vib), pressure: pressao, velocity: arco + drift,
                    position: 0.10, damp: 0.38, noise: 0.08, stroke: 2.8s)
    out corda * 0.8
  }

  bus {
    convolve(ir: corpo_cello, dur: 200ms, mix: 55%)
    reverb(size: 0.75, decay: 1.9s, damp: 4khz, mix: 16%)
  }
}

# Contrabaixo arco: o mais lento da familia (ataque 100-200ms real),
# vibrato 4hz, corpo escuro. Toque e1..g3.
synth contrabaixo {
  poly 3 steal oldest
  gain -5db
  # vibrato opcional: 0 = senza vibrato (arco reto), 1 = normal,
  # ate 2 = largo. No score: set vibrato 0 / automate vibrato ...
  param vibrato: scalar = 1 range 0..2 smooth 60ms
  kill after 10s

  voice {
    let vib_depth = env { 0 -> 0 in 450ms curve lin -> 1 in 800ms curve log }
    let vib = lfo(shape: sine, rate: 4.0hz, amount: 1) * vib_depth * vibrato * 0.22st
    let arco = env { 0 -> 0.8 in 180ms curve exp sustain 0.8 release -> 0 in 280ms curve exp }
    let pressao = (0.56 + velocity * 0.22) * env { 0.45 -> 1 in 240ms curve exp sustain 1 release -> 0.78 in 180ms curve lin }
    let corda = bow(freq: hz(note + vib), pressure: pressao, velocity: arco,
                    position: 0.09, damp: 0.45, noise: 0.07, stroke: 3.2s)
    out corda * 0.85
  }

  bus {
    convolve(ir: corpo_contrabaixo, dur: 220ms, mix: 55%)
    highpass(cutoff: 42hz, q: 0.5)
    reverb(size: 0.8, decay: 2s, damp: 3khz, mix: 16%)
  }
}

# ----------------------------------------------------------- pizzicato

# Pizz de violino: dedo no meio da corda, decay curto (0.3-1s real),
# corpo do violino ressoa. Note off = dedo abafa (mute).
synth violino_pizz {
  poly 6 steal oldest
  gain 5db
  kill after 3s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 30ms curve lin }
    let corda = string(freq: hz(note), decay: 0.9s, bright: 0.55, position: 0.3,
                       exciter: finger, hard: 0.3 + velocity * 0.4, pol: 0.5,
                       mute: abafa)
    out corda * (0.6 + velocity * 0.4)
  }

  bus {
    convolve(ir: corpo_violino, ir2: corpo_violino_r, dur: 120ms, mix: 50%)
    reverb(size: 0.65, decay: 1.4s, damp: 6khz, mix: 12%)
  }
}

# Pizz de cello: mais gordo e longo que violino.
synth cello_pizz {
  poly 5 steal oldest
  gain -2db
  kill after 4s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 40ms curve lin }
    let corda = string(freq: hz(note), decay: 1.6s, bright: 0.48, position: 0.32,
                       exciter: finger, hard: 0.25 + velocity * 0.35, pol: 0.5,
                       tension: 0.08, mute: abafa)
    out corda * (0.6 + velocity * 0.4)
  }

  bus {
    convolve(ir: corpo_cello, dur: 180ms, mix: 55%)
    reverb(size: 0.7, decay: 1.6s, damp: 4.5khz, mix: 14%)
  }
}

# Pizz de contrabaixo (jazz): puxada forte, fundamental sustenta 1-4s,
# agudos morrem logo, leve glide de tensao no ataque. Toque e1..g2.
synth contrabaixo_pizz {
  poly 4 steal oldest
  gain -10db
  kill after 6s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 60ms curve lin }
    let corda = string(freq: hz(note), decay: 3s, bright: 0.4, position: 0.34,
                       exciter: thumb, hard: 0.35 + velocity * 0.35, pol: 0.4,
                       tension: 0.22, stiff: 0.25, mute: abafa)
    out corda * (0.65 + velocity * 0.4)
  }

  bus {
    convolve(ir: corpo_contrabaixo, dur: 200ms, mix: 50%)
    highpass(cutoff: 40hz, q: 0.5)
    reverb(size: 0.7, decay: 1.5s, damp: 3khz, mix: 12%)
  }
}

# Bartok pizz: a corda estala contra o espelho (colisao real do modelo).
synth contrabaixo_bartok {
  poly 4 steal oldest
  gain -9db
  kill after 4s

  voice {
    let corda = string(freq: hz(note), decay: 1.4s, bright: 0.55, position: 0.3,
                       exciter: snap, hard: 0.6 + velocity * 0.3, pol: 0.4,
                       tension: 0.3, stiff: 0.25)
    out corda * (0.6 + velocity * 0.45)
  }

  bus {
    convolve(ir: corpo_contrabaixo, dur: 180ms, mix: 50%)
    reverb(size: 0.7, decay: 1.4s, damp: 3.5khz, mix: 12%)
  }
}

# ---------------------------------------------------------- dedilhadas

# Violao nylon: dedo, cordas de nylon (B baixo, so a 3a corda e grossa),
# corpo A0 100hz + T1 200hz, decay 6-8s. Toque e2..e5.
synth violao {
  poly 8 steal oldest spread 30%
  gain 4db
  kill after 8s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 220ms curve exp }
    let corda = string(freq: hz(note), decay: 7s, bright: 0.55, position: 0.3,
                       exciter: finger, hard: 0.35 + velocity * 0.35, pol: 0.55,
                       stiff: 0.08, tension: 0.05, mute: abafa)
    out corda * (0.55 + velocity * 0.5)
  }

  bus {
    convolve(ir: corpo_violao, ir2: corpo_violao_r, dur: 200ms, mix: 48%)
    reverb(size: 0.6, decay: 1.3s, damp: 5khz, mix: 10%)
  }
}

# Violao aco (folk): palheta, cordas de aco (B maior, mais brilho e
# sustain), o mesmo corpo soa mais metalico.
synth violao_aco {
  poly 8 steal oldest spread 30%
  gain 1db
  kill after 8s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 180ms curve exp }
    let corda = string(freq: hz(note), decay: 6s, bright: 0.72, position: 0.24,
                       exciter: pick, hard: 0.5 + velocity * 0.35, pol: 0.5,
                       stiff: 0.22, tension: 0.07, mute: abafa)
    out corda * (0.55 + velocity * 0.5)
  }

  bus {
    convolve(ir: corpo_violao, ir2: corpo_violao_r, dur: 180ms, mix: 40%)
    reverb(size: 0.6, decay: 1.2s, damp: 6khz, mix: 9%)
  }
}

# Guitarra eletrica limpa: corpo solido nao soa - o "corpo" e o captador
# (tap fisico no waveguide + ressonancia RLC ~3.4khz). Sustain longo.
synth guitarra {
  poly 6 steal oldest spread 20%
  gain 3db
  kill after 10s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 150ms curve exp }
    let corda = string(freq: hz(note), decay: 10s, bright: 0.85, position: 0.16,
                       exciter: pick, hard: 0.6 + velocity * 0.3, pol: 0.35,
                       stiff: 0.14, tension: 0.05, pickup: 0.25, mute: abafa)
    out corda * (0.55 + velocity * 0.5)
  }

  bus {
    # RLC do captador single: pico ~3.4khz e -12db/oct acima
    lowpass(cutoff: 3.4khz, q: 0.95, slope: 12db)
    saturate(amount: 0.12)
    reverb(size: 0.5, decay: 0.9s, damp: 5khz, mix: 7%)
  }
}

# Baixo eletrico (fingerstyle): fundamental pesada, captador P ~2.5khz,
# dispersao real de corda grossa. Toque e1..g3.
synth baixo_eletrico {
  poly 4 steal oldest
  gain 6db
  kill after 12s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 120ms curve exp }
    let corda = string(freq: hz(note), decay: 11s, bright: 0.58, position: 0.28,
                       exciter: finger, hard: 0.4 + velocity * 0.3, pol: 0.3,
                       stiff: 0.3, tension: 0.06, pickup: 0.3, mute: abafa)
    out corda * (0.6 + velocity * 0.45)
  }

  bus {
    lowpass(cutoff: 2.5khz, q: 1.0, slope: 12db)
    saturate(amount: 0.1)
  }
}

# Baixo slap: impulso de velocidade do polegar + colisao com os trastes
# (o "clank" real). Pop = velocity alta.
synth baixo_slap {
  poly 4 steal oldest
  gain 6db
  kill after 6s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 90ms curve exp }
    let corda = string(freq: hz(note), decay: 7s, bright: 0.8, position: 0.14,
                       exciter: slap, hard: 0.6 + velocity * 0.35, pol: 0.35,
                       stiff: 0.3, tension: 0.16, pickup: 0.28, mute: abafa)
    out corda * (0.6 + velocity * 0.5)
  }

  bus {
    lowpass(cutoff: 2.8khz, q: 0.95, slope: 12db)
    compressor(threshold: -14db, ratio: 3, attack: 4ms, release: 90ms)
    saturate(amount: 0.15)
  }
}

# Banjo: corda de aco brilhante sobre membrana - decay curto, formante
# ~580hz, tension modulation ALTA (o twang e FM, nao inharmonicidade).
synth banjo {
  poly 6 steal oldest spread 25%
  gain -2db
  kill after 4s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 100ms curve exp }
    let corda = string(freq: hz(note), decay: 1.2s, bright: 0.85, position: 0.18,
                       exciter: pick, hard: 0.7 + velocity * 0.25, pol: 0.6,
                       stiff: 0.16, tension: 0.3, mute: abafa)
    out corda * (0.55 + velocity * 0.5)
  }

  bus {
    convolve(ir: corpo_banjo, dur: 100ms, mix: 55%)
    reverb(size: 0.45, decay: 0.8s, damp: 6khz, mix: 7%)
  }
}

# Ukulele: nylon curto, caixa pequena (nada abaixo de 180hz), formante
# 1.5-2khz alegre, polpa do dedo arredonda o ataque. Toque c4..a5.
synth ukulele {
  poly 6 steal oldest spread 25%
  gain 3db
  kill after 4s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 140ms curve exp }
    let corda = string(freq: hz(note), decay: 2s, bright: 0.62, position: 0.32,
                       exciter: thumb, hard: 0.5 + velocity * 0.3, pol: 0.5,
                       stiff: 0.05, mute: abafa)
    out corda * (0.55 + velocity * 0.5)
  }

  bus {
    convolve(ir: corpo_ukulele, dur: 120ms, mix: 50%)
    reverb(size: 0.5, decay: 0.9s, damp: 6khz, mix: 9%)
  }
}

# Bandolim: cursos duplos em unissono desafinados por poucos cents -
# o batimento do par e a assinatura. Palheta dura, sustain curto
# (por isso tremolo existe). Toque g3..e6.
synth bandolim {
  poly 6 steal oldest spread 25%
  gain 3db
  kill after 4s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 120ms curve exp }
    let c1 = string(freq: hz(note + 2ct), decay: 1.8s, bright: 0.78, position: 0.22,
                    exciter: pick, hard: 0.65 + velocity * 0.25, pol: 0.5,
                    stiff: 0.24, mute: abafa)
    let c2 = string(freq: hz(note - 2ct), decay: 1.7s, bright: 0.76, position: 0.24,
                    exciter: pick, hard: 0.6 + velocity * 0.25, pol: 0.5,
                    stiff: 0.24, mute: abafa)
    out (c1 + c2) * (0.35 + velocity * 0.3)
  }

  bus {
    convolve(ir: corpo_bandolim, dur: 120ms, mix: 50%)
    reverb(size: 0.55, decay: 1s, damp: 6khz, mix: 10%)
  }
}

# ------------------------------------------------------------ ensemble

# Secao de violinos v2: 6 estantes fisicas independentes - detune
# gaussiano fixo, vibratos com taxa/fase proprias, ataques defasados,
# random walk lento de afinacao por estante (o que separa "secao" de
# "chorus": nada oscila junto). Corpo compartilhado no bus.
synth secao_violinos {
  poly 8 steal oldest
  gain -8db
  # vibrato opcional: 0 = senza vibrato (arco reto), 1 = normal,
  # ate 2 = largo. No score: set vibrato 0 / automate vibrato ...
  param vibrato: scalar = 1 range 0..2 smooth 60ms
  kill after 9s

  voice {
    let vibd = env { 0 -> 0 in 300ms curve lin -> 1 in 550ms curve log }
    let v1 = lfo(shape: sine, rate: 5.1hz, phase: 0.13) * vibd * vibrato * 0.13st
    let v2 = lfo(shape: sine, rate: 5.7hz, phase: 0.61) * vibd * vibrato * 0.15st
    let v3 = lfo(shape: sine, rate: 4.8hz, phase: 0.29) * vibd * vibrato * 0.12st
    let v4 = lfo(shape: sine, rate: 6.1hz, phase: 0.83) * vibd * vibrato * 0.14st
    let v5 = lfo(shape: sine, rate: 5.4hz, phase: 0.47) * vibd * vibrato * 0.13st
    let v6 = lfo(shape: sine, rate: 4.6hz, phase: 0.71) * vibd * vibrato * 0.11st
    # random walk de afinacao por estante (+-2ct lento, dessincronizado)
    let w1 = lfo(shape: sample_hold, rate: 0.7hz, amount: 1) * 2ct
    let w2 = lfo(shape: sample_hold, rate: 0.9hz, amount: 1) * 2ct
    let w3 = lfo(shape: sample_hold, rate: 0.6hz, amount: 1) * 2ct
    let w4 = lfo(shape: sample_hold, rate: 0.8hz, amount: 1) * 2ct
    let w5 = lfo(shape: sample_hold, rate: 0.75hz, amount: 1) * 2ct
    let w6 = lfo(shape: sample_hold, rate: 0.85hz, amount: 1) * 2ct
    let a1 = env { 0 -> 0.9 in 95ms curve exp sustain 0.9 release -> 0 in 200ms curve exp }
    let a2 = env { 0 -> 0.85 in 130ms curve exp sustain 0.85 release -> 0 in 240ms curve exp }
    let a3 = env { 0 -> 0.92 in 75ms curve exp sustain 0.92 release -> 0 in 180ms curve exp }
    let a4 = env { 0 -> 0.84 in 150ms curve exp sustain 0.84 release -> 0 in 260ms curve exp }
    let a5 = env { 0 -> 0.88 in 110ms curve exp sustain 0.88 release -> 0 in 220ms curve exp }
    let a6 = env { 0 -> 0.87 in 140ms curve exp sustain 0.87 release -> 0 in 210ms curve exp }
    let p = 0.42 + velocity * 0.26
    let c1 = bow(freq: hz(note + 7ct + v1 + w1), pressure: p, velocity: a1, position: 0.12, damp: 0.27, noise: 0.09)
    let c2 = bow(freq: hz(note - 5ct + v2 + w2), pressure: p * 0.96, velocity: a2, position: 0.13, damp: 0.3, noise: 0.09)
    let c3 = bow(freq: hz(note + 2ct + v3 + w3), pressure: p * 1.04, velocity: a3, position: 0.11, damp: 0.25, noise: 0.09)
    let c4 = bow(freq: hz(note - 8ct + v4 + w4), pressure: p * 0.92, velocity: a4, position: 0.14, damp: 0.32, noise: 0.09)
    let c5 = bow(freq: hz(note + 5ct + v5 + w5), pressure: p, velocity: a5, position: 0.12, damp: 0.28, noise: 0.09)
    let c6 = bow(freq: hz(note - 2ct + v6 + w6), pressure: p * 1.02, velocity: a6, position: 0.1, damp: 0.26, noise: 0.09)
    out (pan(c1, -0.8) + pan(c2, 0.7) + pan(c3, -0.45) + pan(c4, 0.35)
       + pan(c5, -0.15) + pan(c6, 0.55)) * 0.34
  }

  bus {
    convolve(ir: corpo_violino, ir2: corpo_violino_r, dur: 120ms, mix: 45%)
    reverb(size: 0.8, decay: 2s, damp: 5khz, predelay: 16ms, mix: 14%)
  }
}

# Pizz de secao: 5 estantes de pizzicato defasadas - a "chuva" de dedos.
synth secao_pizz {
  poly 8 steal oldest
  gain 3db
  kill after 3s

  voice {
    let abafa = env { 0 -> 0 in 1ms sustain 0 release -> 1 in 35ms curve lin }
    let c1 = string(freq: hz(note + 6ct), decay: 0.9s, bright: 0.55, position: 0.3, exciter: finger, hard: 0.45, pol: 0.5, mute: abafa)
    let c2 = string(freq: hz(note - 4ct), decay: 0.85s, bright: 0.52, position: 0.32, exciter: finger, hard: 0.4, pol: 0.5, mute: abafa)
    let c3 = string(freq: hz(note + 1ct), decay: 0.95s, bright: 0.57, position: 0.28, exciter: finger, hard: 0.5, pol: 0.5, mute: abafa)
    let c4 = string(freq: hz(note - 7ct), decay: 0.8s, bright: 0.5, position: 0.33, exciter: finger, hard: 0.42, pol: 0.5, mute: abafa)
    let c5 = string(freq: hz(note + 3ct), decay: 0.88s, bright: 0.54, position: 0.31, exciter: finger, hard: 0.47, pol: 0.5, mute: abafa)
    out (pan(c1, -0.7) + pan(c2, 0.6) + pan(c3, -0.3) + pan(c4, 0.4)
       + pan(c5, 0.05)) * 0.4 * (0.6 + velocity * 0.4)
  }

  bus {
    convolve(ir: corpo_violino, ir2: corpo_violino_r, dur: 120ms, mix: 50%)
    reverb(size: 0.75, decay: 1.6s, damp: 5khz, predelay: 14ms, mix: 14%)
  }
}
