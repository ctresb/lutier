  poly 1
  kill after 1s

  voice {
    let modos = [
      (1.012,  0.08s,  1.0),
      (1.492,  0.058s, 0.38),
      (1.655,  0.067s, 0.82),
      (2.024,  0.06s,  0.92),
      (2.578,  0.044s, 0.48),
