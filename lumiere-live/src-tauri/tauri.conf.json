{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumiere-live",
  "version": "0.1.0",
  "identifier": "fun.c3b.lumierelive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MEIAUM MUSICA",
        "width": 1920,
        "height": 200,
        "minWidth": 960,
        "minHeight": 100,
        "resizable": true,
        "backgroundColor": "#030405"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
