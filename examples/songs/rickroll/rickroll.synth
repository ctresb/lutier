# 8bit game homage - "Never Gonna Give You Up" (Rick Astley), reinterpretado.
# Tom real: Bb menor natural. Melodia/acordes pesquisados (hooktheory/songbpm/noobnotes),
# adaptados p/ registro de chip lead. Lead pulse duplo (2 duty cycles, tipo 2A03) +
# bass pulse+triangle + pads.synth (atmosfera) + drums.synth (base ritmica).

import "presets/pads.synth"
import "presets/drums.synth"
import "presets/sfx.synth"

# Lead chiptune: dois pulse (duty 25%+50%, tipo canal duplo NES) p/ corpo mais cheio
# sem perder o carater "8bit". cutoff automatizavel = abre a atmosfera no refrao.
synth chip_lead {
  poly 4 steal oldest
  gain -6db

  param cutoff: hz = 3000 range 800..8000 smooth 15ms curve log

  voice {
    let osc = pulse(freq: note, width: 0.25, gain: 0.6)
            + pulse(freq: note, width: 0.5, gain: 0.25)
    let amp = adsr(attack: 3ms, decay: 60ms, sustain: 0.7, release: 60ms)
    out lowpass(osc, cutoff: cutoff, q: 0.2, slope: 12db) * amp * velocity
  }

  bus {
    delay_fx(time: 3/8beat, feedback: 20%, mix: 14%, pingpong: true, damp: 5khz)
  }
}

# Baixo chiptune: pulse + triangle (peso do canal triangle do NES).
synth chip_bass {
  poly 3 steal oldest
  gain -4db

  voice {
    let osc = pulse(freq: note, width: 0.5, gain: 0.7)
            + triangle(freq: note, gain: 0.3)
    let amp = adsr(attack: 2ms, decay: 80ms, sustain: 0.6, release: 50ms)
    out lowpass(osc, cutoff: 1800hz, q: 0.15, slope: 12db) * amp * velocity
  }
}

master {
  bus_gain 0db
  compressor(threshold: -17db, ratio: 2.5, attack: 12ms, release: 200ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
