# "daynight cycle" - trilha tranquila para ciclo dia/noite/amanhecer
import "presets/pads.synth"
import "presets/keys.synth"
import "presets/bass.synth"
import "presets/drums.synth"
import "presets/orchestra.synth"
import "presets/sfx.synth"

synth dawn_riser {
  poly 4 steal oldest spread 60%
  gain -12db
  param cutoff: hz = 900 range 300..8500 smooth 80ms curve log
  param bright: scalar = 0.20 range 0..1 smooth 120ms
  kill after 14s
  voice {
    let n = noise(color: pink, density: 0.55)
    let air = highpass(n, cutoff: cutoff, q: 0.2, slope: 12db)
    let tone = sine(freq: note, gain: 0.35) + sine(freq: note + 7st, gain: 0.18)
    let amp = adsr(attack: 6s, decay: 1s, sustain: 0.9, release: 4s)
    out (air * bright + tone * (1 - bright * 0.45)) * amp * velocity
  }
  bus {
    reverb(size: 0.9, decay: 3.5s, damp: 6khz, predelay: 30ms, mix: 35%)
    widen(amount: 60%)
  }
}

synth night_ping {
  poly 8 steal oldest spread 80%
  gain -15db
  kill after 4s
  voice {
    let hit = sine(freq: note, gain: 0.55) + sine(freq: note + 12st, gain: 0.15)
    let amp = env { 1 -> 0.25 in 80ms curve exp -> 0 in 1800ms curve exp }
    out hit * amp * velocity
  }
  bus {
    delay_fx(time: 3/8beat, feedback: 35%, mix: 25%, pingpong: true, damp: 5khz)
    reverb(size: 0.8, decay: 2.8s, damp: 4khz, predelay: 18ms, mix: 28%)
    widen(amount: 55%)
  }
}

master {
  bus_gain -2db
  compressor(threshold: -18db, ratio: 2.2, attack: 18ms, release: 220ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
