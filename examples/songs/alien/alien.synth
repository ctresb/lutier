# Alien - misterio em tons inteiros. Theremin com parcial em razao aurea
# (ringmod 1.618 = inarmonico, nao soa "instrumento terrestre") + pads de vidro,
# sinal de radio (pulsar) e transicoes da familia riser.
import "presets/pads.synth"
import "presets/keys.synth"
import "presets/bass.synth"
import "presets/drums.synth"
import "presets/sfx.synth"

# A voz alienigena: mono com glide longo, vibrato lento, sombra ringmod.
synth theremin_alien {
  mono glide 120ms legato
  gain -7db

  voice {
    let vib = lfo(shape: sine, rate: 4.6hz, amount: 1)
    let tone = sine(freq: note + vib * 0.25st, gain: 0.8)
             + sine(freq: hz(note) * 2.02, gain: 0.12)
    let ghost = ringmod(sine(freq: note, gain: 0.5), sine(freq: hz(note) * 1.618, gain: 1)) * 0.3
    let amp = adsr(attack: 350ms, decay: 200ms, sustain: 0.85, release: 900ms)
    out (tone + ghost) * amp * velocity
  }

  bus {
    delay_fx(time: 3/8beat, feedback: 40%, mix: 22%, pingpong: true, damp: 3khz)
    reverb(size: 0.9, decay: 4s, damp: 4khz, mix: 28%)
    widen(amount: 60%)
  }
}

# Sinal de radio alien: blips com pitch aleatorio por degraus (sample_hold).
synth pulsar {
  poly 4 steal oldest
  gain -13db
  kill after 2s

  voice {
    let seq = lfo(shape: sample_hold, rate: 0.5beat, amount: 1)
    let blip = sine(freq: note + seq * 7st, gain: 0.6)
    let gatep = unipolar(lfo(shape: square, rate: 0.5beat, phase: 0.25))
    let amp = adsr(attack: 10ms, decay: 80ms, sustain: 0.6, release: 200ms)
    out blip * gatep * amp * velocity
  }

  bus {
    delay_fx(time: 3/16beat, feedback: 35%, mix: 30%, pingpong: true, damp: 5khz)
    widen(amount: 55%)
  }
}

master {
  bus_gain 0db
  compressor(threshold: -17db, ratio: 2.5, attack: 12ms, release: 200ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
