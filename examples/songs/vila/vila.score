# "vila do moinho" - Sol maior @ 104bpm, swing 56, forma A/B/A (96 beats ~55s)
# I-V-vi-IV com melodia pergunta/resposta na kalimba; flauta responde na seção B.
tempo 104

track kal kalimba
swing 56
humanize 8ms 10%
track fl flute_lead
humanize 10ms 8%
track hp harp
humanize 7ms 8%
track ep epiano_fm
track sb subbass
track shk shaker
swing 56
track ht hat_closed
swing 56

# ---------------- A: manhã na vila ----------------
section manha 32
track ep epiano_fm
0  [g3 b3 d4] 4 0.5 x2 @16
4  [d3 f#3 a3] 4 0.45 x2 @16
8  [e3 g3 b3] 4 0.5 x2 @16
12 [c3 e3 g3] 4 0.45 x2 @16
track sb subbass
0  g1 3.5 0.6 x2 @16
4  d2 3.5 0.55 x2 @16
8  e2 3.5 0.6 x2 @16
12 c2 3.5 0.55 x2 @16
track kal kalimba
# pergunta
0    b4 0.5 0.75
1    d5 0.5 0.7
2    g4 1   0.75
3.5  a4 0.5 0.65
4    b4 0.5 0.7
5    a4 0.5 0.65
6    f#4 1.5 0.7
# resposta
8    b4 0.5 0.75
9    d5 0.5 0.7
10   e5 1   0.78
11.5 d5 0.5 0.68
12   c5 0.5 0.7
13   b4 0.5 0.65
14   g4 2   0.75
# repete variada
16   b4 0.5 0.72
17   d5 0.5 0.68
18   g4 1   0.72
19.5 a4 0.5 0.62
20   b4 0.5 0.68
21   c5 0.5 0.66
22   a4 1.5 0.68
24   g4 0.5 0.72
25   b4 0.5 0.68
26   d5 1   0.75
27.5 e5 0.5 0.68
28   d5 0.5 0.68
29   b4 0.5 0.64
30   g4 2   0.72
track shk shaker
0.5 c5 0.15 0.5 x32 @1
track ht hat_closed
0 c5 0.1 0.35 x16 @2

# ---------------- B: a flauta do moleiro ----------------
section moinho 32
track ep epiano_fm
0  [c3 e3 g3] 4 0.5 x2 @16
4  [g3 b3 d4] 4 0.45 x2 @16
