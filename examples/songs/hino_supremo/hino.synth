# hino supremo - remix do Hino Nacional Brasileiro
# Fa maior, 110bpm, 156 beats (a musica INTEIRA do MIDI original).
# Melodia viaja: bell -> epiano -> flauta -> lead -> trompete + violinos.
# Groove viaja: nada -> atabaque -> tamborzao -> funk -> trap -> marcha epica.
import "presets/pads.synth"      # strings_warm, choir_vox
import "presets/keys.synth"      # bell_fm, epiano_fm, harp, lead_saw
import "presets/physical.synth"  # flauta, trompete, secao_violinos
import "presets/bass.synth"      # subbass
import "presets/drums.synth"     # taiko, snare, hat_open, shaker
import "presets/funk.synth"      # kick_tamborzao, kick_808, bass_808, tamborim,
                                 # atabaque, clap_funk, snare_seca, hat_trap, stab_funk
import "presets/sfx.synth"       # sfx_riser_tonal, sfx_riser, sfx_sub_drop, sfx_impact

master {
  bus_gain -1db
  compressor(threshold: -17db, ratio: 3, attack: 8ms, release: 180ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
