# "do i wanna lovania" - 168 beats @ 88bpm (~115s + cauda)
# Melodia: riff de Megalovania (re menor, cabeca segue o acorde).
# Harmonia/clima: Do I Wanna Know - i-VI-iv-V (Dm-Bb-Gm-A),
# stomp de bumbo 4x4 + palma no 2 e 4, hook do riff vocal transposto.
# Forma: stomp 8 | riff 16 | verse 16 | verse2 16 | build 8 | drop 32 |
#        breakdown 16 | build2 8 | drop2 32 | outro 16
tempo 88

track ld lead_saw
automate cutoff 24 1300 -> 56 2400 curve log -> 64 4800 -> 96 4200 -> 120 5200 -> 152 4600 -> 168 1200 curve exp
humanize 6ms 8%

track pad pad_dark
automate cutoff 0 350 -> 8 800 curve log -> 24 700 -> 56 1200 curve log -> 64 2200 -> 96 1200 curve exp -> 112 1500 curve log -> 120 2400 -> 152 1600 -> 168 400 curve exp

track str strings_warm
automate cutoff 112 600 -> 120 2400 curve log -> 152 1800

track ch choir_vox
automate morph 40 0.2 -> 64 0.65 -> 96 0.35 -> 120 0.7 -> 152 0.3

track hk bass_deep
humanize 6ms 8%
set drv 0.4

track ep epiano_fm
humanize 8ms 8%

track sb subbass
track k kick_deep
track tk taiko
track cl clap_funk
track sn snare_seca
track st stab_funk
track h hat_closed
track sh shaker
track rs sfx_riser_tonal
track rs2 sfx_riser
track sd sfx_sub_drop
track dl sfx_downlifter
track imp sfx_impact

# ---------- stomp: so bateria + pad crescendo (abertura de DIWK) ----------
section stomp 8
  track k kick_deep
  0 c2 0.4 0.72 x4 @2
  1 c2 0.4 0.58 x4 @2
  track cl clap_funk
  1 c4 0.3 0.65 x4 @2
  track pad pad_dark
  0 [d2 a2 d3] 8 0.3
  track hk bass_deep
  7   c2 0.25 0.6
  7.25 d2 0.25 0.6
  7.5 f2 0.5 0.65

