# "lamento do inverno" - melancólico e épico. Ré menor, 72 bpm.

synth strings {
  poly 12 steal oldest spread 70%
  gain -10db

  param cutoff: hz = 700 range 100..8000 smooth 20ms curve log

  global {
    let breath = lfo(shape: sine, rate: 16beat, amount: 0.12)
  }

  voice {
    let osc = saw(freq: note, unison: 7, spread: 14ct, width: 0.8, gain: 0.4)
            + saw(freq: note - 12st, unison: 3, spread: 8ct, width: 0.4, gain: 0.18)
    let amp = adsr(attack: 1.8s, decay: 600ms, sustain: 0.85, release: 3.5s)
    let tone = lowpass(osc, cutoff: cutoff, q: 0.25, slope: 24db)
    out tone * amp * velocity * (1 + breath)
  }

  bus {
    chorus(voices: 4, depth: 35%, rate: 0.3hz, mix: 30%)
    widen(amount: 45%)
    reverb(size: 0.95, decay: 5s, damp: 3.5khz, predelay: 30ms, mix: 32%)
  }
}

synth choir {
  poly 8 steal oldest spread 40%
  gain -13db

  param morph: scalar = 0.3 range 0..1

  voice {
    let vox = wavetable(freq: note, table: "vox", pos: morph, gain: 0.6)
            + wavetable(freq: note + 0.07st, table: "vox", pos: morph + 0.1, gain: 0.4)
    let amp = adsr(attack: 2.5s, decay: 800ms, sustain: 0.8, release: 4s)
    out lowpass(vox, cutoff: 2.2khz, q: 0.2) * amp * velocity
  }

  bus {
    reverb(size: 0.9, decay: 6s, damp: 3khz, predelay: 40ms, mix: 38%)
  }
}

synth bell {
  poly 6 steal oldest
  gain -9db
  kill after 7s

  voice {
    let idx  = adsr(attack: 1ms, decay: 900ms, sustain: 0.05, release: 400ms)
    let m    = sine(freq: hz(note) * 3.01, gain: 1)
    let tine = sine(freq: note, fm: m * idx * 4)
    let amp  = adsr(attack: 1ms, decay: 2.2s, sustain: 0.1, release: 900ms)
    out tine * amp * velocity
  }

  bus {
    delay_fx(time: 3/4beat, feedback: 42%, mix: 26%, pingpong: true, damp: 3khz)
    reverb(size: 0.8, decay: 3.5s, mix: 24%)
  }
}

synth harp {
  poly 8 steal quietest
  gain -8db
  kill after 5s

  voice {
    let string = pluck(freq: note, damp: 0.35, decay: 3s, position: 22%)
    out lowpass(string, cutoff: 3khz, q: 0.15) * velocity
  }

  bus {
    reverb(size: 0.85, decay: 3s, damp: 4khz, mix: 22%)
  }
}

synth subbass {
  mono glide 60ms legato
  gain -6db

  voice {
    let raw = sine(freq: note - 12st, gain: 0.8) + saw(freq: note, gain: 0.25)
    let amp = adsr(attack: 60ms, decay: 300ms, sustain: 0.8, release: 400ms)
    out lowpass(raw, cutoff: 300hz, q: 0.2) * amp * velocity
  }
}

synth taiko {
  poly 3 steal oldest
  gain -4db

  voice {
    let pd  = env { 90hz -> 45hz in 40ms curve exp -> 36hz in 200ms curve lin }
    let amp = env { 1.0 -> 0.6 in 120ms curve exp -> 0.0 in 500ms curve exp }
    let skin = lowpass(noise(color: brown, gain: 1.2), cutoff: 300hz, q: 0.3)
             * env { 1 -> 0 in 40ms curve exp }
    out (sine(freq: pd) + skin) * amp * velocity
  }

  bus {
    reverb(size: 0.7, decay: 1.8s, damp: 2khz, mix: 15%)
  }
}

master {
  bus_gain -1db
  compressor(threshold: -17db, ratio: 2.5, attack: 12ms, release: 200ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
