# "ui pulse" - 35s @ 110bpm, minimal tech loop para screen recording de UI
# Forma: boot -> operate -> popup -> resolve. C menor, frio/funcional.
tempo 110

track pad pad_dark
automate cutoff 0 420 -> 16 900 curve log -> 48 1400 curve log -> 64 650 curve exp
track bass bass_deep
set drv 0.35
track tick soft_tick
humanize 4ms 8%
track bell bell_fm
humanize 7ms 8%
track hat hat_closed
track kick kick_deep
track ui sfx_ui_click

section boot 16
  track pad pad_dark
  0 [c3 g3 d4] 8 0.38
  8 [ab2 eb3 bb3] 8 0.34
  track tick soft_tick
  0 c7 0.1 0.38 x16 @1
  0.5 g6 0.1 0.24 x16 @1
  track bass bass_deep
  0 c2 1 0.36 x4 @4
  8 ab1 1 0.32 x4 @4
  track bell bell_fm
  2 g5 0.25 0.32
  6 c6 0.25 0.34
  10 bb5 0.25 0.30
  14 eb6 0.25 0.34

section operate 32
  track kick kick_deep
  0 c2 0.25 0.44 x16 @2
  track hat hat_closed
  0.5 c5 0.1 0.22 x32 @1
  track tick soft_tick
  0 c7 0.08 0.48 x32 @1
  0.5 g6 0.08 0.26 x32 @1
  3.5 d7 0.08 0.32 x8 @4
  track bass bass_deep
  0 c2 0.6 0.55 x4 @8
  2 c2 0.35 0.35 x4 @8
  4 g1 0.6 0.50 x4 @8
  6 bb1 0.35 0.35 x4 @8
  track pad pad_dark
  0 [c3 g3 d4] 8 0.42
  8 [ab2 eb3 bb3] 8 0.38
  16 [f2 c3 g3] 8 0.38
  24 [g2 d3 a3] 8 0.40
  track bell bell_fm
  0 g5 0.25 0.42
  2 c6 0.25 0.38
  4 d6 0.25 0.35
  7 bb5 0.25 0.34
  8 eb6 0.25 0.42
  10 d6 0.25 0.36
  12 c6 0.25 0.34
  15 g5 0.25 0.32
  16 f5 0.25 0.40
  18 g5 0.25 0.36
  20 bb5 0.25 0.36
  23 c6 0.25 0.40
  24 d6 0.25 0.42
  28 c6 0.25 0.34
  30 g5 0.25 0.32

section popup 8
  track pad pad_dark
  0 [f2 c3 gb3] 8 0.46
  track kick kick_deep
  0 c2 0.25 0.38 x4 @2
  track tick soft_tick
  0 c7 0.08 0.36 x8 @1
  0.25 c7 0.08 0.22 x8 @1
  0.5 gb6 0.08 0.30 x8 @1
  track bell bell_fm
  0 gb5 0.5 0.42
  2 f5 0.5 0.38
  4 eb5 0.5 0.36
  6 d5 0.5 0.34
  track ui sfx_ui_click
  7 c5 0.1 0.45

section resolve 8
  track pad pad_dark
  0 [c3 g3 d4] 8 0.34
  track bass bass_deep
  0 c2 2 0.42
  track tick soft_tick
  0 c7 0.08 0.30 x4 @1
  track bell bell_fm
  0 g5 0.25 0.32
  2 c6 0.5 0.34
  6 c5 1.5 0.28

arrange boot operate popup resolve
