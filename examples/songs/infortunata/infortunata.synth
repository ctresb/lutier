# infortunata
import "presets/pads.synth"
import "presets/keys.synth"
import "presets/bass.synth"
import "presets/drums.synth"

# Sopranos/tenores em uníssono - a melodia-cântico. Mais presente que o coro de fundo.
synth choir_lead {
  poly 4 steal oldest
  gain -7db

  voice {
    let vox = wavetable(freq: note, table: "vox", pos: 0.45, gain: 0.7)
            + wavetable(freq: note + 0.08st, table: "vox", pos: 0.55, gain: 0.35)
            + saw(freq: note, unison: 3, spread: 6ct, width: 0.3, gain: 0.12)
    let amp = adsr(attack: 120ms, decay: 200ms, sustain: 0.9, release: 500ms)
    out lowpass(vox, cutoff: 3khz, q: 0.2) * amp * velocity
  }

  bus {
    widen(amount: 30%)
    reverb(size: 0.9, decay: 4s, damp: 3.5khz, predelay: 25ms, mix: 28%)
  }
}

# Gongo/tam-tam para os golpes orquestrais.
synth gong {
  poly 2 steal oldest
  gain -8db
  kill after 8s

  voice {
    let hit = modal(freq: note, modes: bell, strike: 25%, decay: 6s)
    out lowpass(hit, cutoff: 2khz, q: 0.2) * velocity
  }

  bus {
    reverb(size: 0.95, decay: 5s, damp: 2.5khz, mix: 30%)
  }
}

master {
  bus_gain -1db
  compressor(threshold: -17db, ratio: 2.5, attack: 12ms, release: 200ms, makeup: auto)
  limiter(ceiling: -1db, lookahead: 5ms, release: 80ms)
}
