# funky
# tamborzao: kick 3-3-2 em semicolcheias (0, 0.75, 1.5 | 2, 2.75, 3.5)
# 32 compassos de 4 tempos @ 130bpm ~ 59s

tempo 130

# ---- tamborzao (kick) ----
track kick grave_kick
0.00 c2 0.3 1.00 x32 @4
0.75 c2 0.3 0.85 x32 @4
1.50 c2 0.3 0.95 x32 @4
2.00 c2 0.3 1.00 x32 @4
2.75 c2 0.3 0.85 x32 @4
3.50 c2 0.3 0.95 x32 @4

# ---- palma (backbeat) ----
track clap palma
1 c4 0.2 0.9 x32 @4
3 c4 0.2 0.9 x32 @4

# ---- chimbal (contratempo + fill) ----
track hat chimbal
0.50 c6 0.1 0.7 x32 @4
1.50 c6 0.1 0.6 x32 @4
2.50 c6 0.1 0.7 x32 @4
3.50 c6 0.1 0.6 x32 @4
3.75 c6 0.1 0.5 x32 @4

# ---- grave (entra no compasso 4, segue o kick) ----
track bass sub_grave
16.00 d2 0.6 0.95 x28 @4
16.75 d2 0.5 0.80 x28 @4
17.50 f2 0.4 0.85 x28 @4
18.00 d2 0.6 0.95 x28 @4
18.75 c2 0.5 0.80 x28 @4
19.50 d2 0.4 0.85 x28 @4

# ---- lead "apito" (entra no compasso 8, frase de 2 compassos) ----
track lead lead_apito
32.0 d5 0.5  0.85 x12 @8
32.5 f5 0.5  0.80 x12 @8
33.0 a5 0.75 0.90 x12 @8
34.0 g5 0.5  0.80 x12 @8
34.5 f5 0.5  0.75 x12 @8
35.0 e5 0.5  0.80 x12 @8
35.5 d5 1.0  0.85 x12 @8
37.0 c5 0.5  0.75 x12 @8
37.5 d5 0.5  0.80 x12 @8
38.0 f5 1.0  0.85 x12 @8
39.0 e5 0.5  0.75 x12 @8
39.5 d5 0.5  0.80 x12 @8
