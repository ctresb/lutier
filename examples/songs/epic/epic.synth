# "a última badalada" - epic orchestral-ish patch set

# ---- sino de igreja (partiais inarmônicos + strike metálico) ----
synth sino {
  poly 6 steal oldest
  gain -5db
  kill after 10s

  voice {
    # partiais clássicos de sino: hum (-12st), prime, tierce (+3st),
    # quint (+9st), nominal (+12st), superquint (+19st)
    let hum    = sine(freq: note - 12st, gain: 0.85) * env { 1 -> 0 in 8s   curve exp }
    let prime  = sine(freq: note,        gain: 0.70) * env { 1 -> 0 in 6s   curve exp }
    let tierce = sine(freq: note + 3st,  gain: 0.55) * env { 1 -> 0 in 4s   curve exp }
    let quint  = sine(freq: note + 9st,  gain: 0.35) * env { 1 -> 0 in 2.5s curve exp }
    let nom    = sine(freq: note + 12st, gain: 0.30) * env { 1 -> 0 in 1.8s curve exp }
    let sup    = sine(freq: note + 19st, gain: 0.18) * env { 1 -> 0 in 900ms curve exp }

    # batimento lento entre partiais (aquele "wobble" de sino real)
    let beatmod = lfo(shape: sine, rate: 1.3hz, amount: 0.12)
    let body = (hum + prime + tierce * (1 + beatmod) + quint + nom + sup)

    # strike: clang metálico curto
    let strike = bandpass(noise(gain: 0.8), cutoff: 3khz, q: 2.0)
               * env { 1 -> 0 in 18ms curve exp }

    out (body * 0.9 + strike) * velocity
  }

  bus {
    reverb(size: 0.92, decay: 4.5s, damp: 4khz, mix: 30%)
  }
}

# ---- taiko / bumbo épico ----
synth taiko {
  poly 3 steal oldest
  gain -2db

  voice {
    let drop = env { 110hz -> 48hz in 30ms curve exp -> 40hz in 200ms curve lin }
    let amp  = env { 1 -> 0.6 in 120ms curve exp -> 0 in 450ms curve exp }
    let body = sine(freq: drop)
    let skin = lowpass(noise(gain: 0.5), cutoff: 900hz, q: 0.4)
             * env { 1 -> 0 in 30ms curve exp }
    out saturate(body * 1.4, amount: 0.3) * amp * velocity + skin * velocity
  }

  bus {
    reverb(size: 0.7, decay: 1.4s, damp: 3khz, mix: 14%)
  }
}

# ---- caixa marcial ----
synth caixa {
  poly 4 steal oldest
  gain -10db

  voice {
    let crack = bandpass(noise(gain: 1), cutoff: 2.2khz, q: 0.5)
    let tone  = sine(freq: 190hz, gain: 0.4) * env { 1 -> 0 in 60ms curve exp }
    let amp   = env { 1 -> 0 in 140ms curve exp }
    out crack * amp * velocity + tone * velocity
  }

  bus {
    reverb(size: 0.5, decay: 0.9s, damp: 5khz, mix: 12%)
  }
}

# ---- cordas (pad de saw em unison) ----
synth cordas {
  poly 8 steal quietest
  gain -14db

  voice {
    let osc = saw(freq: note, unison: 5, spread: 14ct, width: 0.8, gain: 0.5)
    let amp = adsr(attack: 400ms, decay: 300ms, sustain: 0.8, release: 900ms)
    let swell = lfo(shape: sine, rate: 0.25hz, amount: 0.15)
    let tone = lowpass(osc, cutoff: 1.4khz + swell * 500hz, q: 0.3)
    out tone * amp * velocity
  }

  bus {
    reverb(size: 0.85, decay: 3s, damp: 4.5khz, mix: 26%)
  }
}

# ---- metais (lead heroico) ----
synth metais {
  poly 4 steal oldest
  gain -9db

  voice {
    let vib = lfo(shape: sine, rate: 5hz, amount: 0.10)
    let osc = saw(freq: note + vib * 0.5st, unison: 3, spread: 9ct, width: 0.5, gain: 0.45)
            + square(freq: note - 12st, gain: 0.18)
    let amp  = adsr(attack: 30ms, decay: 150ms, sustain: 0.75, release: 200ms)
    let fenv = adsr(attack: 20ms, decay: 250ms, sustain: 0.4, release: 150ms)
    let tone = lowpass(osc, cutoff: 900hz + fenv * 2.6khz, q: 0.4)
    out saturate(tone, amount: 0.2) * amp * velocity
  }

  bus {
    delay_fx(time: 3/8beat, feedback: 25%, mix: 15%, pingpong: true, damp: 4khz)
    reverb(size: 0.75, decay: 2s, damp: 5khz, mix: 18%)
  }
}

# ---- baixo grave ----
synth grave {
  mono glide 25ms legato
  gain -5db

  voice {
    let raw = sine(freq: note - 12st, gain: 0.85)
            + saw(freq: note, gain: 0.3)
    let amp  = adsr(attack: 8ms, decay: 250ms, sustain: 0.6, release: 120ms)
    let tone = lowpass(saturate(raw, amount: 0.35), cutoff: 380hz, q: 0.3)
    out tone * amp * velocity
  }
}

master {
  bus_gain -1db
  compressor(threshold: -15db, ratio: 3.5, attack: 10ms, release: 120ms, makeup: auto)
  limiter(ceiling: -0.8db, lookahead: 5ms, release: 60ms)
}
