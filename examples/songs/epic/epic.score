# "a última badalada" - épica em lá menor @ 110bpm
# intro: só badaladas de sino (compassos 1-4)
# depois cordas -> taiko/baixo -> metais heroicos -> badalada final

tempo 110

# ---- badaladas de abertura (a cada 4 tempos, sozinhas) ----
track bell sino
0  a3 4 1.00
4  a3 4 0.90
8  a3 4 0.95
12 e3 4 1.00

# sino pontuando a peça inteira, a cada 8 tempos
16 a3 4 0.7 x10 @8

# badalada final (depois que tudo para)
100 a3 8 1.0
104 a2 8 0.9

# ---- cordas (entram no compasso 5, Am F C G, acordes de 4 tempos) ----
track str cordas
# 2 voltas da progressão só com cordas (beats 16-47), depois seguem até 96
16 a3 4 0.65 x10 @8
16 c4 4 0.60 x10 @8
16 e4 4 0.60 x10 @8
20 f3 4 0.65 x10 @8
20 a3 4 0.60 x10 @8
20 c4 4 0.60 x10 @8
24 c4 4 0.65 x9 @8
24 e4 4 0.60 x9 @8
24 g4 4 0.60 x9 @8
28 g3 4 0.65 x9 @8
28 b3 4 0.60 x9 @8
28 d4 4 0.60 x9 @8

# ---- taiko (entra no compasso 9 / beat 32) ----
track drum taiko
32.0 a1 0.5 1.00 x16 @4
34.0 a1 0.5 0.85 x16 @4
35.5 a1 0.5 0.70 x16 @4

# ---- caixa marcial (junto com taiko) ----
track sn caixa
33 c4 0.2 0.8 x16 @4
35 c4 0.2 0.8 x16 @4
35.75 c4 0.15 0.5 x16 @4

# ---- baixo (segue a progressão, entra beat 32) ----
track bass grave
32 a2 3.5 0.9 x8 @8
36 f2 3.5 0.9 x8 @8
40 c3 3.5 0.9 x8 @8
44 g2 3.5 0.9 x8 @8

# ---- metais heroicos (tema entra no beat 48, frase de 8 tempos) ----
track lead metais
48.0 a4 1.5 0.90 x3 @16
49.5 c5 0.5 0.80 x3 @16
50.0 e5 2.0 0.95 x3 @16
52.0 d5 1.0 0.85 x3 @16
53.0 c5 1.0 0.80 x3 @16
54.0 b4 1.5 0.85 x3 @16
55.5 g4 0.5 0.75 x3 @16
56.0 a4 4.0 0.95 x3 @16
60.0 e5 1.0 0.85 x3 @16
61.0 f5 1.0 0.90 x3 @16
62.0 g5 2.0 0.95 x3 @16

# clímax final: tema uma oitava acima (beat 96 não - acaba em 96)
