24 g4  1    0.62
25 b4  1    0.66
26 d5  2    0.7
28 c5  2    0.72
30 d5  0.75 0.55
31 b4  1    0.5
# --- caixinha dobra as notas longas 8va (o brilho) ---
track mb music_box
2  e5  2 0.42
6  bb4 2 0.4
10 f5  2 0.44
14 c5  2 0.42
18 e5  2 0.42
22 a4  2 0.4
26 d5  2 0.42
28 c5  3 0.44
# --- harpa ondulando em pentatônica (funciona sobre todos os acordes) ---
track hp harp
0 c4 0.5 0.32 x8 @4
1 g4 0.5 0.3  x8 @4
2 e4 0.5 0.32 x8 @4
3 d4 0.5 0.28 x8 @4
track bp boop
15 c4 0.75 0.52
track shk shaker
0.5 c5 0.15 0.28 x32 @1
track kik kick_deep
0 c2 0.2 0.3 x8 @4

# ============================================================
# C: RESPIRO - a caixinha de música canta o HOOK INTEIRO em meio-tempo,
# quase sozinha. O momento "uau" do loop. Sem percussão.
# Prog: | F | C | F | C | F | C | G7 | C->G |
# ============================================================
section respiro 32
track ep epiano_fm
0  [f3 a3 c4]    3.5 0.3
4  [c3 e3 g3]    3.5 0.3
8  [f3 a3 c4]    3.5 0.3
12 [c3 e3 g3]    3.5 0.3
16 [f3 a3 c4]    3.5 0.3
20 [c3 e3 g3]    3.5 0.3
24 [g2 b2 d3 f3] 3.5 0.3
28 [c3 e3 g3]    2   0.3
30 [g2 b2 d3]    2   0.28
track bd bass_deep
0  f1 3.5 0.5
4  c2 3.5 0.5
8  f1 3.5 0.5
12 c2 3.5 0.5
16 f1 3.5 0.5
20 c2 3.5 0.5
24 g1 3.5 0.5
28 c2 2   0.5
30 g1 2   0.45
# --- o hook em meio-tempo, sonhando ---
track mb music_box
0  g4  2 0.5
2  c5  2 0.52
4  e5  4 0.55
8  f5  2 0.52
10 d5  2 0.5
12 bb4 4 0.54
16 a4  2 0.5
18 c5  2 0.52
20 f5  4 0.56
24 e5  2 0.5
26 d5  2 0.48
28 c5  4 0.54
# --- harpa só nos compassos de F (e no G7, onde o f3 vira sétima) ---
track hp harp
0 f3 0.5 0.3  x4 @8
1 c4 0.5 0.28 x4 @8
2 a3 0.5 0.3  x4 @8
3 c4 0.5 0.26 x4 @8
track bp boop
14.5 c4 0.75 0.5
30.5 g3 0.75 0.45

arrange tema calor respiro calor
