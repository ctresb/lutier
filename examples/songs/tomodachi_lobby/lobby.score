# "PRACINHA v2" - Dó mixolídio (Bb = a cor da casa) @ 80bpm, swing 55.
# Lobby lento, suave, loopável SEM emenda: 128 beats @ 80bpm = 96.000s exatos.
# O HOOK: duas semínimas subindo + mínima segurada, todo compasso, em TODA seção.
#   sobe (g c e~) | cai (f d bb~) | sobe (a c f~) | resolve (e d c~~)
# Última seção termina em G (dominante) puxando o Dó do reinício = loop resolve.
tempo 80

track kal kalimba
swing 55
humanize 9ms 10%
track mb music_box
humanize 8ms 8%
track hp harp
swing 55
humanize 8ms 10%
track ep epiano_fm
humanize 7ms 6%
track str strings_warm
automate cutoff 0 800 -> 32 800 -> 48 1500 curve log -> 64 800 curve exp -> 96 850 -> 112 1600 curve log -> 128 900
track bd bass_deep
track bp boop
track shk shaker
swing 55
humanize 8ms 12%
track kik kick_deep

# ============================================================
# A: TEMA - kalimba canta o hook nu, epiano acolchoa, quase nada mais.
# Prog: | C | Bb | F | C | C | Bb | F | C |
# ============================================================
section tema 32
track ep epiano_fm
0  [c3 e3 g3]  3.5 0.34
4  [bb2 d3 f3] 3.5 0.32
8  [f3 a3 c4]  3.5 0.34
12 [c3 e3 g3]  3.5 0.32
16 [c3 e3 g3]  3.5 0.34
20 [bb2 d3 f3] 3.5 0.32
24 [f3 a3 c4]  3.5 0.34
28 [c3 e3 g3]  3.5 0.34
track bd bass_deep
0  c2  3.5 0.55
4  bb1 3.5 0.55
8  f1  3.5 0.55
12 c2  3.0 0.55
15.5 g1 0.5 0.4
16 c2  3.5 0.55
20 bb1 3.5 0.55
24 f1  3.5 0.55
28 c2  3.0 0.55
31.5 g1 0.5 0.4
# --- O HOOK, devagar e cantado ---
track kal kalimba
0  g4  1    0.62
1  c5  1    0.66
2  e5  2    0.7
4  f5  1    0.66
5  d5  1    0.62
6  bb4 2    0.68
8  a4  1    0.62
9  c5  1    0.66
10 f5  2    0.72
12 e5  1    0.64
13 d5  1    0.6
14 c5  1.75 0.68
16 g4  1    0.6
17 c5  1    0.66
18 e5  2    0.7
20 f5  1    0.66
21 d5  1    0.62
22 bb4 2    0.68
24 a4  1    0.62
25 c5  1    0.66
26 d5  2    0.7
28 c5  3    0.72
# --- caixinha pisca ecos nas notas seguradas ---
track mb music_box
2.5  e5 1   0.35
10.5 f5 1   0.35
14.5 c5 1.5 0.38
18.5 e5 1   0.35
26.5 d5 1   0.35
29   c5 2   0.4
# --- boop fecha as duas frases, discreto ---
track bp boop
15 c4 0.75 0.5
31 g3 0.75 0.45
track shk shaker
0.5 c5 0.15 0.24 x32 @1

# ============================================================
# B: CALOR - cordas florescem, harpa ondula, hook segue na kalimba
# com a caixinha dobrando as notas longas. 2a metade abre (Am F G C).
# Prog: | C | Bb | F | C | Am | F | G | C->G |  (G puxa o loop)
# ============================================================
section calor 32
track ep epiano_fm
0  [c3 e3 g3]  3.5 0.36
4  [bb2 d3 f3] 3.5 0.34
8  [f3 a3 c4]  3.5 0.36
12 [c3 e3 g3]  3.5 0.34
16 [a2 c3 e3]  3.5 0.36
20 [f2 a2 c3]  3.5 0.34
24 [g2 b2 d3]  3.5 0.36
28 [c3 e3 g3]  2   0.36
30 [g2 b2 d3]  2   0.34
track str strings_warm
0  [g3 c4 e4]  4 0.28
4  [f3 bb3 d4] 4 0.26
8  [f3 a3 c4]  4 0.28
12 [g3 c4 e4]  4 0.26
16 [e3 a3 c4]  4 0.28
20 [f3 a3 c4]  4 0.26
24 [g3 b3 d4]  4 0.28
28 [g3 d4]     4 0.26
track bd bass_deep
0  c2  3.5 0.58
4  bb1 3.5 0.56
8  f1  3.5 0.58
12 c2  3.0 0.56
